[Unit]
Description=OpenDesk Relay Server
Documentation=https://github.com/opendesk/opendesk-relay
After=network.target
Wants=network-online.target

[Service]
Type=simple

# === Path — il relay server è ora standalone in ../opendesk-relay ===
# With uv:
ExecStart=/home/giampaolo/.local/bin/uv run --directory /home/giampaolo/Codium/opendesk-relay relay-server --port 8474
# With pip (alternative):
# ExecStart=/usr/bin/python3 -m relay_server --port 8474

# === Configuration ===
Restart=on-failure
RestartSec=5
# Reload del certificato TLS senza restart (il server gestisce SIGHUP)
ExecReload=/bin/kill -HUP $MAINPID
User=giampaolo
Group=giampaolo

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/home/giampaolo/.opendesk

# Limiti risorse: ogni frame puo' dichiarare fino a max_message_size byte,
# quindi un tetto di memoria evita che N connessioni concorrenti portino
# giu' la macchina (il processo viene terminato e riavviato).
MemoryHigh=768M
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
